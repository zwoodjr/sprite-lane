const GRADES := ["haze", "drift", "refinery", "city", "quarantine", "raider", "chemical", "military", "crater", "dustfall"]


static func info(name: String) -> Dictionary:
	return META.get(name, {})


## Collision rect (world px, relative to the sprite centre), or an empty Rect2.
static func block_rect(name: String, flip: bool = false) -> Rect2:
	var m: Dictionary = META.get(name, {})
	if not m.has("block"):
		return Rect2()
	var r: Rect2 = m["block"]
	if flip:
		r.position.x = -r.position.x - r.size.x
	return Rect2(r.position * UnitAnim.TEXEL, r.size * UnitAnim.TEXEL)
