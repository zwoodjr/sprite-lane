[gd_scene load_steps=2 format=3 uid="uid://wanderer_char_select"]

[ext_resource type="Script" path="res://scripts/ui/character_select.gd" id="1_char"]

[node name="CharacterSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
