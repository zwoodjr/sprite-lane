; Engine configuration file.
; Godot 4.3 — Project Wanderer MVP

config_version=5

[application]

config/name="Wanderer"
config/description="Solo top-down extraction survival — iPhone-first MVP vertical slice"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
TouchInput="*res://scripts/autoload/touch_input.gd"
DisplayFit="*res://scripts/autoload/display_fit.gd"
Juice="*res://scripts/autoload/juice.gd"
UiTheme="*res://scripts/autoload/ui_theme.gd"

[display]

; Portrait design size (survivor FOV + single bottom stick). Stretch/expand fills Xogot/iOS.
window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale=1.0
window/stretch/scale_mode="fractional"
; 1 = portrait (single-stick survivor layout)
window/handheld/orientation=1
window/ios/hide_home_indicator=true
window/per_pixel_transparency/allowed=false

[input_devices]

pointing/emulate_touch_from_mouse=true

[input]

